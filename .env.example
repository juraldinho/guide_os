# Core local configuration
BOT_TOKEN=
ADMIN_ID=0
TIMEZONE=Asia/Tashkent
DATABASE_PATH=guide_os.db
APP_ENV=development

# GuideShop features are off by default.
GUIDESHOP_READS_ENABLED=false
GUIDESHOP_LINKING_ENABLED=false
GUIDESHOP_EVENTS_ENABLED=false
GUIDESHOP_NOTIFICATIONS_ENABLED=false
GUIDESHOP_USE_FAKE=false
GUIDESHOP_LINK_PROVIDER_ENABLED=false
GUIDESHOP_LINK_PROVIDER_STAGING_ENABLED=false
GUIDESHOP_LINK_PROVIDER_PRODUCTION_ENABLED=false
GUIDESHOP_LINK_PROVIDER_HOST=127.0.0.1
GUIDESHOP_LINK_PROVIDER_PORT=8081
GUIDESHOP_STAGING_LIFECYCLE_ENABLED=false
GUIDESHOP_STAGING_LIFECYCLE_JWT_PUBLIC_KEYS={}
GUIDESHOP_PRODUCTION_LIFECYCLE_ENABLED=false
GUIDESHOP_PRODUCTION_LIFECYCLE_JWT_PUBLIC_KEYS={}

# GuideShop HTTP defaults. Leave the endpoint blank unless using real composition.
GUIDESHOP_API_BASE_URL=
GUIDESHOP_API_TIMEOUT_SECONDS=10.0
GUIDESHOP_API_MAX_RETRIES=2
GUIDESHOP_API_MAX_RETRY_AFTER_SECONDS=10.0

# Real JWT values are required only when reads are enabled and the fake is disabled.
GUIDESHOP_JWT_KEY_ID=
GUIDESHOP_JWT_PRIVATE_KEY=
GUIDESHOP_LINK_JWT_PUBLIC_KEYS={}
# Supply the multiline private key through the environment or a secrets manager.
# Never commit private-key material to this template or a local environment file.

# Guide Operator service auth (GO8B). Off by default; fail-closed when enabled.
# Separate keys from GuideShop. Never reuse GUIDESHOP_JWT_* material here.
GUIDE_OS_SERVICE_AUTH_ENABLED=false
GUIDE_OS_GUIDE_OPERATOR_JWT_PUBLIC_KEYS={}
GUIDE_OS_SIGNING_KID=
GUIDE_OS_SIGNING_PRIVATE_KEY_PEM=

# Guide Operator inbound event HTTP (GO8D1). Off by default.
# API-only process: python guide_operator_integration_api.py
# Requires GUIDE_OS_SERVICE_AUTH_ENABLED=true with complete GO8B keys.
GUIDE_OS_GUIDE_OPERATOR_INTEGRATION_ENABLED=false
GUIDE_OS_GUIDE_OPERATOR_INTEGRATION_HOST=127.0.0.1
GUIDE_OS_GUIDE_OPERATOR_INTEGRATION_PORT=8084

# Guide Operator outbound event delivery (GO8F2A). Off by default; fail-closed.
# Requires GUIDE_OS_SERVICE_AUTH_ENABLED=true with outbound signing keys.
# HTTPS required when APP_ENV is staging or production.
GUIDE_OS_GUIDE_OPERATOR_OUTBOUND_ENABLED=false
GUIDE_OS_GUIDE_OPERATOR_BASE_URL=

# Guide Operator outbound delivery worker (GO8F2B). Off by default; fail-closed.
# Separate process only — never start from bot / Mini App / GO8D integration API:
#   python guide_operator_outbound_worker.py
#   python guide_operator_outbound_worker.py --once
# Requires GUIDE_OS_GUIDE_OPERATOR_OUTBOUND_ENABLED=true with complete GO8B signing.
# Poll interval seconds: 1–300 (default 5). Batch size: 1–50 (default 10).
GUIDE_OS_GUIDE_OPERATOR_OUTBOUND_WORKER_ENABLED=false
GUIDE_OS_GUIDE_OPERATOR_OUTBOUND_WORKER_ONCE=false
GUIDE_OS_GUIDE_OPERATOR_OUTBOUND_WORKER_POLL_INTERVAL_SECONDS=5
GUIDE_OS_GUIDE_OPERATOR_OUTBOUND_WORKER_BATCH_SIZE=10
# GO9A local two-service E2E is a test harness only. Do not enable the flags above in .env for normal runs.

# Guide Operator guide-notification Telegram delivery (GO10A2A). Off by default; fail-closed.
# Reusable deliver_one_notification() boundary. Requires BOT_TOKEN + HTTPS MINI_APP_PUBLIC_URL.
GUIDE_OS_GUIDE_OPERATOR_NOTIFICATION_DELIVERY_ENABLED=false

# Guide Operator guide-notification drain worker (GO10A2B). Off by default; fail-closed.
# Starts only inside python bot.py as one background task (no second bot / getUpdates).
# Requires GUIDE_OS_GUIDE_OPERATOR_NOTIFICATION_DELIVERY_ENABLED=true with complete settings.
# Poll interval seconds: 1–300 (default 5). Batch size: 1–50 (default 10).
# Shutdown timeout seconds: 1–120 (default 15) — finishes current send then stops.
GUIDE_OS_GUIDE_OPERATOR_NOTIFICATION_WORKER_ENABLED=false
GUIDE_OS_GUIDE_OPERATOR_NOTIFICATION_WORKER_POLL_INTERVAL_SECONDS=5
GUIDE_OS_GUIDE_OPERATOR_NOTIFICATION_WORKER_BATCH_SIZE=10
GUIDE_OS_GUIDE_OPERATOR_NOTIFICATION_WORKER_SHUTDOWN_TIMEOUT_SECONDS=15

# Guide OS Mini App (MA5+). Off by default; initData auth in MA6.
# Public pilot: set MINI_APP_ENABLED=true and MINI_APP_API_ENABLED=true together.
# Rollback: set both to false. Production uses MINI_APP_API_DEV_AUTH=false.
# Bot and Mini App API must run in one process (python bot.py) for shared SQLite.
MINI_APP_ENABLED=false
MINI_APP_PUBLIC_URL=
MINI_APP_API_ENABLED=false
MINI_APP_API_HOST=127.0.0.1
MINI_APP_API_PORT=8083
MINI_APP_API_DEV_AUTH=false
MINI_APP_SESSION_TTL_SECONDS=3600
MINI_APP_INITDATA_MAX_AGE=86400
MINI_APP_API_ALLOWLIST=
