# Core local configuration
BOT_TOKEN=
ADMIN_ID=0
TIMEZONE=Asia/Tashkent
DATABASE_PATH=guide_os.db
APP_ENV=development

# GuideShop features are off by default.
GUIDESHOP_READS_ENABLED=false
GUIDESHOP_LINKING_ENABLED=false
GUIDESHOP_EVENTS_ENABLED=false
GUIDESHOP_NOTIFICATIONS_ENABLED=false
GUIDESHOP_USE_FAKE=false
GUIDESHOP_LINK_PROVIDER_ENABLED=false
GUIDESHOP_LINK_PROVIDER_STAGING_ENABLED=false
GUIDESHOP_LINK_PROVIDER_PRODUCTION_ENABLED=false
GUIDESHOP_LINK_PROVIDER_HOST=127.0.0.1
GUIDESHOP_LINK_PROVIDER_PORT=8081
GUIDESHOP_STAGING_LIFECYCLE_ENABLED=false
GUIDESHOP_STAGING_LIFECYCLE_JWT_PUBLIC_KEYS={}
GUIDESHOP_PRODUCTION_LIFECYCLE_ENABLED=false
GUIDESHOP_PRODUCTION_LIFECYCLE_JWT_PUBLIC_KEYS={}

# GuideShop HTTP defaults. Leave the endpoint blank unless using real composition.
GUIDESHOP_API_BASE_URL=
GUIDESHOP_API_TIMEOUT_SECONDS=10.0
GUIDESHOP_API_MAX_RETRIES=2
GUIDESHOP_API_MAX_RETRY_AFTER_SECONDS=10.0

# Real JWT values are required only when reads are enabled and the fake is disabled.
GUIDESHOP_JWT_KEY_ID=
GUIDESHOP_JWT_PRIVATE_KEY=
GUIDESHOP_LINK_JWT_PUBLIC_KEYS={}
# Supply the multiline private key through the environment or a secrets manager.
# Never commit private-key material to this template or a local environment file.

# Guide OS Mini App (MA5+). Off by default; initData auth in MA6.
# Public pilot: set MINI_APP_ENABLED=true and MINI_APP_API_ENABLED=true together.
# Rollback: set both to false. Production uses MINI_APP_API_DEV_AUTH=false.
# Bot and Mini App API must run in one process (python bot.py) for shared SQLite.
MINI_APP_ENABLED=false
MINI_APP_PUBLIC_URL=
MINI_APP_API_ENABLED=false
MINI_APP_API_HOST=127.0.0.1
MINI_APP_API_PORT=8083
MINI_APP_API_DEV_AUTH=false
MINI_APP_SESSION_TTL_SECONDS=3600
MINI_APP_INITDATA_MAX_AGE=86400
MINI_APP_API_ALLOWLIST=
